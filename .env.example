# Connect to the existing server that owns your threads. Set its actual socket path.
TITLER_ENDPOINT=unix:///absolute/path/to/app-server.sock
TITLER_DATABASE=titler.sqlite3
# REQUIRED operator override. Example only: verify against your server/account limits.
TITLER_CONTEXT_LIMIT=32768
# Set to the effective auto-compaction trigger if lower than the context limit.
TITLER_AUTO_COMPACT_LIMIT=32768
TITLER_OUTPUT_RESERVE=2048
TITLER_SERVER_OVERHEAD=4096
TITLER_SAFETY_MARGIN=2048
TITLER_THRESHOLD=120
TITLER_TITLE_LIMIT=80
TITLER_DEBOUNCE=2
TITLER_RECONCILE_INTERVAL=60
TITLER_CONCURRENCY=2
TITLER_INVALID_RETRIES=1
TITLER_CONTEXT_RETRIES=2
TITLER_REQUEST_TIMEOUT=60
TITLER_GENERATION_TIMEOUT=180
TITLER_READ_RETRIES=3
TITLER_BACKOFF=1
TITLER_COOLDOWN=300
TITLER_QUEUE_SIZE=1000
TITLER_MAX_MESSAGE_BYTES=67108864
TITLER_LOG_LEVEL=INFO
TITLER_DRY_RUN=false
# For authenticated ws/wss endpoints, supply the token through the environment:
# TITLER_BEARER_TOKEN=...
# Optional explicit separate process (does NOT observe an existing app's live events):
# TITLER_STDIO_COMMAND=["codex","app-server","--listen","stdio://"]
# Optional per-helper configuration (JSON object); built-in isolation overrides take priority.
# TITLER_HELPER_CONFIG={}
